# ==========================================
# LLMRouter Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit secrets!)
# ------------------------------------------
.env
.env.*
!.env.example
.credentials.json
*.key
*.pem
*.cert

# ------------------------------------------
# Go (Backend)
# ------------------------------------------
# Compiled binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
backend/bin/

# Test artifacts and coverage profiles
*.test
*.out
coverage.txt
coverage.html
profile.out

# ------------------------------------------
# Node / Frontend (React + Vite)
# ------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.pnp
.pnp.js

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Rust & Tauri Desktop Layer
# ------------------------------------------
target/
**/src-tauri/target/
**/gen/schemas/
**/*.pdb

# Tauri sidecar binaries
**/src-tauri/binaries/*-*

# ------------------------------------------
# SQLite Databases & Local Storage
# ------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
logs/
tmp/
temp/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code (preserve shared settings/extensions recommendations if present)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
